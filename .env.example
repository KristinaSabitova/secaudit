# Copy to .env on the server and fill in. Never commit the real .env.

# PostgreSQL password for the secaudit role (any long random string).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Shared secret for GitHub webhook signatures. Paste the same value into the
# hook's "Secret" field on GitHub.
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Encrypts the audit-backend API key entered in the dashboard, so a database
# dump on its own does not disclose it. Rotating this makes an already-stored
# key unreadable and it has to be entered again.
#   openssl rand -hex 32
SECAUDIT_SECRET_KEY=

# Docker network the existing reverse proxy runs on, so it can reach the app
# as http://secaudit-app:8000 without publishing a public port.
PROXY_NETWORK=spectra_default

# ---------------------------------------------------------------------------
# Audit backend — pick one. /api/health reports whether it is actually usable.
# ---------------------------------------------------------------------------

SECAUDIT_BACKEND=anthropic-api

# anthropic-api — paid, no local hardware needed.
ANTHROPIC_API_KEY=

# openai-api — paid.
#   SECAUDIT_BACKEND=openai-api
# OPENAI_API_KEY=

# ollama — free and local, no account. Needs a *generative* model pulled
# (embedding models such as bge-m3 cannot produce findings) and enough RAM:
# roughly 5 GB for an 8B model, 1-2 GB for a small one like qwen2.5-coder:1.5b.
# The URL must be reachable from inside the container, so localhost will not do:
# use http://host.docker.internal:11434 for an Ollama on the host, or the
# container name if it shares a docker network with this stack.
#   SECAUDIT_BACKEND=ollama
#   SECAUDIT_OLLAMA_URL=http://host.docker.internal:11434
#   SECAUDIT_MODEL=qwen2.5-coder

# claude-code — needs the 'claude' binary, which is not in this image.
# Use it when running the app outside Docker.

# Optional: override the model for any backend.
# SECAUDIT_MODEL=

# Other optional overrides.
# SECAUDIT_TIMEOUT=1800
# SECAUDIT_PORT=8811

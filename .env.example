# Copy to .env on the server and fill in. Never commit the real .env.

# PostgreSQL password for the secaudit role (any long random string).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Shared secret for GitHub webhook signatures. Paste the same value into the
# hook's "Secret" field on GitHub.
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Encrypts the audit-backend API key entered in the dashboard, so a database
# dump on its own does not disclose it. Rotating this makes an already-stored
# key unreadable and it has to be entered again.
#   openssl rand -hex 32
SECAUDIT_SECRET_KEY=

# ---------------------------------------------------------------------------
# Sign-in with GitHub. Register an OAuth App at
# https://github.com/settings/developers with the callback URL
#   https://<your domain>/api/auth/callback
# Without these two, nobody can sign in and the dashboard stays empty.
# ---------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# The address browsers reach this instance at, used to build the OAuth callback.
# Only needed when the proxy does not forward the original host.
# SECAUDIT_PUBLIC_URL=https://secaudit.example.com

# Comma-separated GitHub logins allowed to sign in. REQUIRED: left empty,
# nobody can sign in at all. Signing in means making this server clone
# repositories and spend an API budget, so an unset variable closes the
# instance rather than opening it. Set it to * to accept any GitHub account,
# which is a deliberate choice and not a default.
SECAUDIT_ALLOWED_GITHUB_LOGINS=

# GitHub login that administers this instance: it can see webhook-triggered
# audits and everyone else's. REQUIRED whenever the two OAuth variables above
# are set — the app refuses to start without it. It used to be granted to
# whoever signed in first, which on a reachable instance is a race a stranger
# can win.
SECAUDIT_ADMIN_GITHUB_LOGIN=

# Docker network the existing reverse proxy runs on, so it can reach the app
# as http://secaudit-app:8000 without publishing a public port. Set it to
# whatever `docker network ls` calls that network on your host — compose joins
# it as an external network and will not create it.
PROXY_NETWORK=proxy_default

# ---------------------------------------------------------------------------
# Audit backend — pick one. /api/health reports whether it is actually usable.
# ---------------------------------------------------------------------------

SECAUDIT_BACKEND=anthropic-api

# anthropic-api — paid, no local hardware needed.
ANTHROPIC_API_KEY=

# openai-api — paid.
#   SECAUDIT_BACKEND=openai-api
# OPENAI_API_KEY=

# ollama — free and local, no account. Needs a *generative* model pulled
# (embedding models such as bge-m3 cannot produce findings) and enough RAM:
# roughly 5 GB for an 8B model, 1-2 GB for a small one like qwen2.5-coder:1.5b.
# The URL must be reachable from inside the container, so localhost will not do:
# use http://host.docker.internal:11434 for an Ollama on the host, or the
# container name if it shares a docker network with this stack.
#   SECAUDIT_BACKEND=ollama
#   SECAUDIT_OLLAMA_URL=http://host.docker.internal:11434
#   SECAUDIT_MODEL=qwen2.5-coder
#
# The server fetches whatever address is configured here and reports what came
# back, so on a hosted instance — where a signed-in stranger can type one — an
# address inside your own network is refused. Name the hosts this instance may
# reach and they are accepted however they resolve. A personal instance
# (SECAUDIT_SINGLE_USER) needs none of this: it may reach its own machine.
#   SECAUDIT_ALLOWED_OLLAMA_HOSTS=ollama,host.docker.internal

# claude-code — needs the 'claude' binary, which is not in this image.
# Use it when running the app outside Docker.

# Optional: override the model for any backend.
# SECAUDIT_MODEL=

# Other optional overrides.
# SECAUDIT_TIMEOUT=1800

# Language the backend writes findings in when nobody chooses one — which is
# the case for webhook-triggered audits. "en" (default) or "es"; dashboard
# audits carry the language of whoever asked for them.
# SECAUDIT_DEFAULT_LANGUAGE=es

# How much source code travels inside a single request to an API backend
# (anthropic-api, openai-api, ollama), in characters. These backends cannot
# open files themselves, so this is all the code the model gets to see.
# Default 200000 (~50k tokens); a local model through ollama gets a quarter of
# it. Raising it covers more of a large repository and costs more per audit.
# SECAUDIT_CONTEXT_CHARS=200000
# How many requests one audit may be split into (default 8). This times
# SECAUDIT_CONTEXT_CHARS is the most one audit can send: its cost ceiling.
# SECAUDIT_MAX_CHUNKS=8
# After the audit, one more request asks the model to argue the strongest
# findings false (the devil's advocate). This is how many it may argue against;
# 0 turns it off. Its quotes are checked against the code like any evidence.
# SECAUDIT_MAX_REFUTATIONS=8
# Then the same request is sent again with 2-3 decoy vulnerabilities planted in
# a copy of its files, to measure whether the auditor still sees them: one more
# request. This is the most decoys it plants; 0 turns it off.
# SECAUDIT_CANARIES=3
# For each finding fixed since the previous audit of a project, the model is
# asked for a Semgrep rule, kept only if it catches the code before the fix
# and not after: one more request. This is how many fixes per audit; 0 is none.
# SECAUDIT_MAX_RULES=3
# Commits of history each clone fetches, for provenance (git blame) and to
# find the commit that fixed a finding. Default 200.
# SECAUDIT_HISTORY_DEPTH=200
# A read-only GitHub token (fine-grained: contents, metadata and pull requests,
# read) for the leverage map: who approved a file's last changes and whether
# the default branch requires reviews. Without it those are reported as
# unknown. It stays in the server; the audit process never sees it.
# SECAUDIT_GITHUB_TOKEN=
# The published package of a Python or npm repository is fetched from PyPI or
# npm and compared with its git tag. 0 turns that off (no registry is asked).
# SECAUDIT_PUBLISHED_CHECK=1
# Only repositories of these GitHub owners (users or organisations, comma
# separated, case-insensitive) may be audited, from the UI or a webhook.
# Empty accepts any owner.
# SECAUDIT_ALLOWED_REPO_OWNERS=
# 1 asks OSV.dev for known vulnerabilities of the exact versions read from
# manifests and lockfiles. Off by default: package names and versions leave
# the server. Nothing else (no code, no path) is sent.
# SECAUDIT_OSV_CHECK=0
# 1 asks each direct dependency's registry (PyPI, npm, crates.io) for its last
# release and whether it is deprecated, to flag abandoned packages. Off by
# default: package names leave the server. Nothing else is sent.
# SECAUDIT_ABANDONED_CHECK=0
# Report a pull request's audit back on the pull request: one comment (edited
# on each push) and a "secaudit" commit status. Off by default. "summary" posts
# counts and a link only; "full" also lists each new finding's title and
# file:line, which on a public repository publishes where the weaknesses are.
# Needs a token with "Pull requests: write" and "Commit statuses: write",
# separate from the read-only SECAUDIT_GITHUB_TOKEN. The link needs
# SECAUDIT_PUBLIC_URL (https).
# SECAUDIT_PR_COMMENTS=summary
# SECAUDIT_GITHUB_WRITE_TOKEN=
# What If can run the repository's tests in a throwaway Docker container (no
# network while testing, read-only, no capabilities, as nobody, with limits),
# on the audited commit and on the patched one. Off by default: it runs code
# from the audited repository. Needs a Docker daemon where the server runs;
# do NOT mount the Docker socket into the server's container to get one
# (that hands the host to the server). Images must already be on the host.
# SECAUDIT_WHATIF_SANDBOX=docker
# 1 installs dependencies first, in a separate container that has network
# (npm with --ignore-scripts; pip can still run build code, inside it).
# SECAUDIT_SANDBOX_INSTALL=0
# SECAUDIT_SANDBOX_PYTHON_IMAGE=python:3.12-slim
# SECAUDIT_SANDBOX_NODE_IMAGE=node:20-slim
# SECAUDIT_SANDBOX_TIMEOUT=300
# SECAUDIT_SANDBOX_MEMORY_MB=1024
# SECAUDIT_SANDBOX_CPUS=1
# The rule scanners run in a separate process with these limits. Past them the
# scan fails and the audit says so; the web server is not affected.
# SECAUDIT_SCAN_TIMEOUT=600
# SECAUDIT_SCAN_MEMORY_MB=2048
# Bounds on what the rule scanners (secrets, dependencies, MCP, surface) read
# from a checkout: total characters and number of files. Past them the rest is
# skipped and the audit says so.
# SECAUDIT_MAX_SCAN_CHARS=64000000
# SECAUDIT_MAX_SCAN_FILES=20000
# SECAUDIT_PORT=8811

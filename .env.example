# Copy to .env on the server and fill in. Never commit the real .env.

# PostgreSQL password for the secaudit role (any long random string).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Shared secret for GitHub webhook signatures. Paste the same value into the
# hook's "Secret" field on GitHub.
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Credentials for the audit backend.
ANTHROPIC_API_KEY=

# Optional overrides.
# SECAUDIT_BACKEND=anthropic-api
# SECAUDIT_TIMEOUT=1800
# SECAUDIT_PORT=8811
